# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Chapa Payments (https://dashboard.chapa.co -> Settings -> API)
# Use the CHASECK_TEST-... key while testing, CHASECK-... for live payments.
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
# Optional: the "Secret hash" you set for webhooks in the Chapa dashboard
CHAPA_WEBHOOK_SECRET=

# Session signing (required in production). At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a key derived from SUPABASE_SERVICE_ROLE_KEY is used.
SESSION_SECRET=

# Owner super admin account (there are no demo accounts). Needed locally and in production.
# Phone like +251911234567 or 0911234567; password at least 8 characters.
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

# Telegram (create the bot with @BotFather)
TELEGRAM_BOT_TOKEN=
# Bot username without "@", e.g. SelamKidsBot (public: used by the login button)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Random string Telegram echoes back on every webhook call (A-Z, a-z, 0-9, _ and -)
TELEGRAM_WEBHOOK_SECRET=

# Subscriptions
TRIAL_DAYS=14
SUBSCRIPTION_PERIOD_DAYS=30
SUBSCRIPTION_PRICE_ETB=300
